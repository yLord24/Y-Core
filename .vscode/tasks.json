{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Y Core: Build Game",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\build-game.ps1",
				"-Game",
				"${input:gameName}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Y Core: Serve Local",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\tools\\serve-local.ps1",
				"-Port",
				"8124"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "gameName",
			"type": "promptString",
			"description": "Game id to build",
			"default": "shinsei"
		}
	]
}
