{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Y Core: Build Game",
			"type": "shell",
			"command": "${workspaceFolder}\\tools\\YCoreBuild.exe",
			"args": [
				"${input:gameName}"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Y Core: Serve Local",
			"type": "shell",
			"command": "${workspaceFolder}\\tools\\YCoreDev.exe",
			"args": [
				"--port",
				"8124"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "gameName",
			"type": "promptString",
			"description": "Game id to build",
			"default": "shinsei"
		}
	]
}
